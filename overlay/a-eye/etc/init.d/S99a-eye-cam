#!/bin/sh

SUPERVISOR=/usr/bin/rkipc-supervisor.sh
PIDFILE=/run/rkipc-supervisor.pid
RKIPC=/oem/usr/bin/rkipc
INI=/usr/share/rkipc-imx415-720p.ini
IQ_FILE=/usr/share/iqfiles/imx415_CMK-OT2022-PX1_IR0147-36IRC-8M-F20.json

stop_existing() {
	killall rkipc 2>/dev/null || true

	count=0
	while pidof rkipc >/dev/null 2>&1; do
		count=$((count + 1))
		if [ "$count" -ge 5 ]; then
			echo "Timed out waiting for rkipc to stop" >&2
			return 1
		fi
		sleep 1
	done
}

supervisor_running() {
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE")
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start() {
	if [ ! -x "$SUPERVISOR" ]; then
		echo "Missing rkipc supervisor: $SUPERVISOR" >&2
		return 1
	fi
	if [ ! -x "$RKIPC" ]; then
		echo "Missing rkipc executable: $RKIPC" >&2
		return 1
	fi
	if [ ! -f "$INI" ]; then
		echo "Missing IMX415 rkipc profile: $INI" >&2
		return 1
	fi
	if [ ! -f "$IQ_FILE" ]; then
		echo "Missing IMX415 IQ file: $IQ_FILE" >&2
		return 1
	fi

	if supervisor_running; then
		echo "rkipc supervisor is already running"
		return 0
	fi
	rm -f "$PIDFILE"
	stop_existing || return 1

	printf "Starting rkipc supervisor: "
	if ! start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$SUPERVISOR"; then
		rm -f "$PIDFILE"
		echo "FAILED"
		return 1
	fi
	sleep 1
	if ! supervisor_running; then
		rm -f "$PIDFILE"
		echo "Supervisor failed to start; see /tmp/rkipc.log" >&2
		return 1
	fi
	echo "OK"
}

stop() {
	if supervisor_running; then
		pid=$(cat "$PIDFILE")
		start-stop-daemon -K -q -p "$PIDFILE" || true

		count=0
		while kill -0 "$pid" 2>/dev/null; do
			count=$((count + 1))
			if [ "$count" -ge 5 ]; then
				kill -KILL "$pid" 2>/dev/null || true
				break
			fi
			sleep 1
		done
	fi
	rm -f "$PIDFILE"
	stop_existing
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop && start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac
