# JPEG measurement thresholds, in luma values.
# Keep usable borderline indoor images in day mode.
NIGHT_ON_THRESHOLD=75
DAY_ON_THRESHOLD=75
# Day mode also requires p90_y to fall in this inclusive acceptance band.
# At 10% IR LED, lights-off night p90_y was 97-100; lights-on night was 124-125.
DAY_P90_MIN=110
DAY_P90_MAX=210
# Subtract this estimated IR LED contribution from mean_y for the day-return
# check while night mode and its LED are active. p90_y is not compensated.
NIGHT_LED_MEAN_COMPENSATION=20
INTERVAL_SECONDS=2
# Wait this long after changing mode before sampling the camera again.
MODE_SETTLE_SECONDS=10
SWITCH_SAMPLES_REQUIRED=2
# IR LED output as a percentage of the device's reported max_brightness.
LED_INTENSITY_PERCENT=10
# The C++ service defaults to live sensor controls through V4L2. The existing
# JPEG measurement method remains selectable with --measurement-method jpeg.
MEASUREMENT_METHOD=v4l2
V4L2_DEVICE=
# Initial V4L2 score thresholds from SC3336 readings (dark: about 32; lower-
# light day: about 1065). IMX415 with IR-cut and IR LED enabled still needs
# measurement and calibration. No LED score compensation until measured.
V4L2_NIGHT_ON_THRESHOLD=100
V4L2_DAY_ON_THRESHOLD=500
V4L2_LED_COMPENSATION=0
# Optional independent triggers; 0 disables them until sensor-specific
# calibration establishes useful values.
NIGHT_EXPOSURE_THRESHOLD_SECONDS=0
DAY_GAIN_MAX=0
